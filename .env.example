# OpenRouter API Configuration
# Get your API key from https://openrouter.ai/keys
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Model to use (default: Llama 3.1 70B Instruct)
OPENROUTER_MODEL=openai/gpt-4o-mini

# Site URL for OpenRouter (optional)
OPENROUTER_SITE_URL=http://localhost:3000

# Site Name for OpenRouter (optional)
OPENROUTER_SITE_NAME=WWF Presentation Generator

# Unsplash API Configuration
# Get your access key from https://unsplash.com/oauth/applications
# Create an application and use the Access Key
UNSPLASH_ACCESS_KEY=your_unsplash_access_key_here

# Optional: only needed if you later add OAuth/user-authorized Unsplash actions.
# Keep this server-side and never expose it in browser code.
UNSPLASH_SECRET_KEY=your_unsplash_secret_key_here

# Unsplash Application ID (optional, for reference)
UNSPLASH_APPLICATION_ID=your_unsplash_application_id_here
